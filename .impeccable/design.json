  "components": [
    {
      "name": "Node",
      "kind": "custom",
      "refersTo": "node",
      "description": "Hairline Edge frame, 10px radius; title bar with a lane-coloured dot; 16px body; input and output sockets on the top and bottom edges.",
      "html": "<div class=\"ds-node\"><span class=\"ds-socket ds-in\"></span><div class=\"ds-bar\">Reels</div><div class=\"ds-body\"><p>A body of rows, prose or the reel. <a class=\"ds-link\" href=\"#\">A link</a>.</p></div><span class=\"ds-socket ds-out\"></span></div>",
      "css": ":host{--bg:#fff;--fg:#111;--text:#3b3b3b;--muted:#6b6b6b;--line:#ebebeb;--underline:#a3a3a3;--edge:#dedede;--bar:#fafafa;--film:#4f8cc9;--ai:#b565b2;}.ds-node{position:relative;width:420px;max-width:100%;background:var(--bg);border:1px solid var(--edge);border-radius:10px;font-family:Geist,-apple-system,'Segoe UI',system-ui,sans-serif;font-size:15px;line-height:1.7;color:var(--text)}.ds-bar{display:flex;align-items:center;gap:10px;padding:8px 16px;border-bottom:1px solid var(--line);border-radius:9px 9px 0 0;background:var(--bar);color:var(--fg);font-weight:500}.ds-bar::before{content:'';width:8px;height:8px;border-radius:50%;background:var(--film)}.ds-body{padding:16px}.ds-body p{margin:0}.ds-socket{position:absolute;left:calc(50% - 6px);width:12px;height:12px;border:2px solid var(--bg);border-radius:50%;background:var(--film)}.ds-in{top:-7px}.ds-out{bottom:-7px}.ds-link{color:var(--fg);text-decoration:underline;text-decoration-color:var(--underline);text-decoration-thickness:1px;text-underline-offset:3px}"
    },
    {
      "name": "Link",
      "kind": "custom",
      "refersTo": "link",
      "description": "The only link style: Ink text, 1px Underline Grey underline offset 3px, darkening on hover.",
      "html": "<p class=\"ds-p\">Apps like <a class=\"ds-link\" href=\"#\">harlo</a> and <a class=\"ds-link\" href=\"#\">ComfyPilot</a>.</p>",
      "css": ":host{--bg:#fff;--fg:#111;--text:#3b3b3b;--muted:#6b6b6b;--line:#ebebeb;--underline:#c4c4c4;--still:#f2f2f2;}.ds-p{font-family:Geist,-apple-system,'Segoe UI',system-ui,sans-serif;font-size:15px;line-height:1.7;color:var(--text);margin:0}.ds-link{color:var(--fg);text-decoration:underline;text-decoration-color:var(--underline);text-decoration-thickness:1px;text-underline-offset:3px;transition:text-decoration-color 150ms ease-out}.ds-link:hover{text-decoration-color:currentColor}.ds-link:focus-visible{outline:2px solid var(--fg);outline-offset:3px;border-radius:3px}"
    },
    {
      "name": "Headings",
      "kind": "custom",
      "refersTo": "headline",
      "description": "Name/section heading (600, Ink) and block heading (500, Quiet Grey), both 15px.",
      "html": "<div class=\"ds-h2\">Film &amp; VFX</div><div class=\"ds-h3\">Reels</div>",
      "css": ":host{--bg:#fff;--fg:#111;--text:#3b3b3b;--muted:#6b6b6b;--line:#ebebeb;--underline:#c4c4c4;--still:#f2f2f2;}.ds-h2,.ds-h3{font-family:Geist,-apple-system,'Segoe UI',system-ui,sans-serif;font-size:15px;line-height:1.5}.ds-h2{font-weight:600;color:var(--fg)}.ds-h3{font-weight:500;color:var(--muted);margin-top:16px}"
    },
    {
      "name": "Rows",
      "kind": "custom",
      "refersTo": "row",
      "description": "Title left, tabular meta right, 1px hairline between.",
      "html": "<ul class=\"ds-rows\"><li><a class=\"ds-link\" href=\"#\">Unreal environment reel</a><span class=\"ds-meta\">2025</span></li><li><a class=\"ds-link\" href=\"#\">VFX demo reel</a><span class=\"ds-meta\">2020</span></li></ul>",
      "css": ":host{--bg:#fff;--fg:#111;--text:#3b3b3b;--muted:#6b6b6b;--line:#ebebeb;--underline:#c4c4c4;--still:#f2f2f2;}.ds-rows{list-style:none;margin:0;padding:0;width:580px;max-width:100%;font-family:Geist,-apple-system,'Segoe UI',system-ui,sans-serif;font-size:15px;line-height:1.7}.ds-rows li{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:baseline;column-gap:16px;padding:10px 0;border-top:1px solid var(--line)}.ds-rows li:last-child{border-bottom:1px solid var(--line)}.ds-rows a{justify-self:start}.ds-link{color:var(--fg);text-decoration:underline;text-decoration-color:var(--underline);text-decoration-thickness:1px;text-underline-offset:3px;transition:text-decoration-color 150ms ease-out}.ds-link:hover{text-decoration-color:currentColor}.ds-meta{color:var(--muted);font-size:14px;font-variant-numeric:tabular-nums;white-space:nowrap}"
    },
