  "narrative": {
    "northStar": "The Plain Page",
    "overview": "One narrow column of text and quiet lists, in the modern minimal developer register. Hierarchy comes from weight and colour, never from size: the name, the section headings and the body all sit at 15px. Everything after the bio is a row (title left, details right, a hairline between), with small real images only where the work is visual.\n\nThe world is neutral grey on white, or on near-black when the system is dark; there is no accent colour. Links are text-coloured with a thin underline. Motion is limited to short colour and opacity transitions, and none of it runs under reduced motion. The only behaviour is the reel: a still (or a lone Play pill) that becomes the Vimeo player when pressed.",
    "keyCharacteristics": [
      "One 580px measure, centred, generous top space.",
      "One type size (15px), stepped by weight (400/500/600) and colour; 14px only for meta and small print.",
      "Neutral palette, light and dark by `prefers-color-scheme`, no accent.",
      "Rows with 1px hairlines as the universal list form.",
      "Flat: no shadows, no cards, no gradients."
    ],
    "rules": [
      {
        "name": "The No Accent Rule",
        "body": "Nothing is coloured. Emphasis is Ink against Body Grey; interaction is an underline darkening to `currentColor`.",
        "section": "colors"
      },
      {
        "name": "The Two Modes Rule",
        "body": "A new colour is only allowed as a light/dark pair under the same role name. The one exception is the Play pill over a still, which sits on the image and uses fixed black at 66% (86% on hover) with white text, the same in both modes.",
        "section": "colors"
      },
      {
        "name": "The One Size Rule",
        "body": "Hierarchy is weight and colour, not size. A new heading is 15px; it steps by 600/500 and Ink/Quiet Grey. (Recorded as a detector exception, `flat-type-hierarchy`, in `.impeccable/config.json`; Geist is likewise a recorded `overused-font` exception.)",
        "section": "typography"
      },
      {
        "name": "The Tabular Meta Rule",
        "body": "Every number in a meta column uses tabular figures so years and dates align down a list.",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Separation is a 1px Hairline line or ring, never a shadow, card or background panel.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep every text element at 15px (14px for meta/footer) and step hierarchy with weight 600/500/400 and Ink/Quiet Grey.",
      "**Do** present any new list as rows: title left, tabular meta right, 1px Hairline between.",
      "**Do** give every image a Still fill and a 1px Hairline ring.",
      "**Do** define any new colour as a light/dark pair under one role.",
      "**Do** limit motion to 150-200ms ease-out colour/opacity transitions, removed under `prefers-reduced-motion`."
    ],
    "donts": [
      "**Don't** add an accent colour, gradient, or coloured link.",
      "**Don't** use drop shadows, cards or tinted panels to separate content; use the hairline.",
      "**Don't** set a heading larger than body size.",
      "**Don't** load embeds (players, iframes) before the visitor asks for them."
    ]
  }
}