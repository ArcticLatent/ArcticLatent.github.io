      "css": ":host{--bg:#fff;--fg:#111;--text:#3b3b3b;--muted:#6b6b6b;--line:#ebebeb;--underline:#c4c4c4;--still:#f2f2f2;}.ds-pill{display:inline-flex;align-items:center;gap:6px;padding:6px 14px 6px 10px;border-radius:999px;background:var(--fg);color:var(--bg);font-family:Geist,-apple-system,'Segoe UI',system-ui,sans-serif;font-size:14px;font-weight:500;text-decoration:none;transition:opacity 200ms ease-out}.ds-pill:hover{opacity:.86}.ds-pill:focus-visible{outline:2px solid var(--fg);outline-offset:3px}.ds-len{opacity:.7;font-variant-numeric:tabular-nums}"
