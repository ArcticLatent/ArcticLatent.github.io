    {
      "name": "Contact node",
      "kind": "nav",
      "refersTo": "node",
      "description": "The footer as the last node: neutral title-bar dot, inputs from both lanes, contact links at 14px.",
      "html": "<div class=\"ds-node\"><span class=\"ds-socket ds-in\" style=\"left:calc(25% - 6px)\"></span><span class=\"ds-socket ds-in\" style=\"left:calc(75% - 6px);background:var(--ai)\"></span><div class=\"ds-bar ds-neutral\">Contact</div><div class=\"ds-body ds-contact\"><a class=\"ds-link\" href=\"#\">burce.boran@gmail.com</a><a class=\"ds-link\" href=\"#\">LinkedIn</a><a class=\"ds-link\" href=\"#\">Résumé</a></div></div>",
      "css": ":host{--bg:#fff;--fg:#111;--text:#3b3b3b;--muted:#6b6b6b;--line:#ebebeb;--underline:#a3a3a3;--edge:#dedede;--bar:#fafafa;--film:#4f8cc9;--ai:#b565b2;}.ds-node{position:relative;width:420px;max-width:100%;background:var(--bg);border:1px solid var(--edge);border-radius:10px;font-family:Geist,-apple-system,'Segoe UI',system-ui,sans-serif;font-size:15px;line-height:1.7;color:var(--text)}.ds-bar{display:flex;align-items:center;gap:10px;padding:8px 16px;border-bottom:1px solid var(--line);border-radius:9px 9px 0 0;background:var(--bar);color:var(--fg);font-weight:500}.ds-bar::before{content:'';width:8px;height:8px;border-radius:50%;background:var(--film)}.ds-body{padding:16px}.ds-body p{margin:0}.ds-socket{position:absolute;left:calc(50% - 6px);width:12px;height:12px;border:2px solid var(--bg);border-radius:50%;background:var(--film)}.ds-in{top:-7px}.ds-out{bottom:-7px}.ds-link{color:var(--fg);text-decoration:underline;text-decoration-color:var(--underline);text-decoration-thickness:1px;text-underline-offset:3px}.ds-neutral::before{background:var(--underline)}.ds-contact{display:flex;flex-wrap:wrap;gap:0 14px;padding-block:10px;font-size:14px}.ds-contact a{padding:6px 0}"
    }
