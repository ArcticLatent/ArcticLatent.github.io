---
import { Image } from "astro:assets";
import "../styles/global.css";
import { fetchLatestVideos } from "../lib/youtube.js";
import { fetchFilmography, matchCredits } from "../lib/metacritic.js";
import { fetchReels } from "../lib/vimeo.js";
import {
  apps,
  credits,
  email,
  githubUrl,
  imdbUrl,
  linkedinUrl,
  pageDescription,
  pageTitle,
  reels,
  resumeUrl,
  siteUrl,
  structuredData,
  youtubeUrl
} from "../site.js";

const [videos, filmography, reelVideos] = await Promise.all([fetchLatestVideos(), fetchFilmography(), fetchReels(reels)]);
const shownReels = reelVideos.filter((reel) => reel.video);
const [featuredReel] = shownReels;
const shownCredits = matchCredits(credits, filmography);

// On GitHub (the daily rebuild), a section that couldn't be fetched stops
// the build: GitHub Pages then keeps the last good version of the site
// instead of publishing it with that section empty.
if (process.env.GITHUB_ACTIONS && (videos.length === 0 || filmography.length === 0 || shownReels.length < reels.length)) {
  throw new Error(
    `Not publishing: ${videos.length} videos, ${filmography.length} credits, ${shownReels.length} of ${reels.length} reels fetched`
  );
}

const canonicalUrl = `${siteUrl}/`;
// (A PNG: social sites don't show SVG previews. public/og-image.svg is its source.)
const ogImageUrl = `${siteUrl}/og-image.png`;
const reelTitle = (reel) => `${reel.label}, ${reel.video.year}`;
const reelStill = featuredReel && (featuredReel.still === false ? "" : featuredReel.still ?? featuredReel.video.still);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="author" content="Burce Boran" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Geist-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Burce Boran" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Burce Boran, GenAI TD in VFX pipeline" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <main>
      <header id="about">
        <div class="masthead">
          <div>
            <h1>Burce Boran</h1>
            <p class="role">GenAI TD, Pipeline</p>
          </div>
          <!-- A small node graph wired into a wireframe sphere: pipeline into asset. -->
          <svg class="graph" viewBox="0 0 208 72" aria-hidden="true" focusable="false">
            <g class="graph-wires">
              <path d="M44 36 C 58 36, 58 18, 72 18" />
              <path d="M44 36 C 58 36, 58 54, 72 54" />
              <path d="M116 18 C 136 18, 132 36, 148 36" />
              <path d="M116 54 C 136 54, 132 36, 148 36" />
            </g>
            <g class="graph-nodes">
              <rect x="0.5" y="26.5" width="43" height="19" rx="4" />
              <rect x="72.5" y="8.5" width="43" height="19" rx="4" />
              <rect x="72.5" y="44.5" width="43" height="19" rx="4" />
            </g>
            <g class="graph-ports">
              <circle cx="44" cy="36" r="2" />
              <circle cx="72" cy="18" r="2" />
              <circle cx="72" cy="54" r="2" />
              <circle cx="116" cy="18" r="2" />
              <circle cx="116" cy="54" r="2" />
              <circle cx="148" cy="36" r="2" />
            </g>
            <g class="graph-mesh">
              <circle cx="178" cy="36" r="29" />
              <ellipse cx="178" cy="36" rx="29" ry="10" />
              <ellipse cx="178" cy="36" rx="12" ry="29" />
              <path d="M150 27 H206 M150 45 H206" />
            </g>
          </svg>
        </div>
        <p>
          I work in the VFX industry as a GenAI TD in pipeline, bringing generative AI tools and workflows into how
          shows get made. Before that I spent over 15 years in visual effects, most recently as an asset supervisor,
          building and leading the models, textures and look development behind <em>The Mandalorian</em>,
          <em>Star Trek: Discovery</em> and <em>Avatar: The Last Airbender</em>.
        </p>
        <p>
          Outside the studio I make free, open-source apps like
          <a href="https://harlo.run">harlo</a>, <a href="https://github.com/ArcticLatent/ComfyPilot">ComfyPilot</a> and
          <a href="https://github.com/ArcticLatent/Bootcraft">Bootcraft</a>, and on my YouTube channel,
          <a href={youtubeUrl}>Arctic Latent</a>, I teach artists ComfyUI and AI workflows. Before the channel I taught 3D
          surfacing at Seneca Polytechnic for four years, and I've spoken about careers in VFX and 3D at TIFF Next Wave and
          Anadolu University.
        </p>
        <p>
          Get in touch at <a href={`mailto:${email}`}>{email}</a> or on <a href={linkedinUrl}>LinkedIn</a>, or read my
          <a href={resumeUrl}>résumé</a> (PDF).
        </p>
        <nav class="index" aria-label="On this page">
          <div>
            <span>Film &amp; VFX</span>
            <a href="#reels">Reels</a>
            <a href="#films">Credits</a>
          </div>
          <div>
            <span>AI tools &amp; teaching</span>
            <a href="#apps">Apps</a>
            <a href="#videos">Videos</a>
          </div>
        </nav>
      </header>

      <section aria-labelledby="film-title">
        <h2 id="film-title">Film &amp; VFX</h2>

        <div class="block" id="reels">
          <h3>Reels</h3>
          {featuredReel ? (
            <>
              <figure class="reel">
                <div class="reel-frame" data-reel-frame>
                  <a
                    class:list={["reel-still", !reelStill && "is-blank"]}
                    href={featuredReel.url}
                    data-reel={featuredReel.video.id}
                    data-reel-title={reelTitle(featuredReel)}
                    aria-label={`Play ${reelTitle(featuredReel)}`}
                  >
                    {reelStill &&
                      (reelStill.startsWith("/") ? (
                        <img src={reelStill} width="1280" height="720" alt="" />
                      ) : (
                        <Image src={reelStill} width={1280} height={720} alt="" loading="eager" />
                      ))}
                    <span class="play" aria-hidden="true">
                      <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5.5v13l10.5-6.5z" /></svg>
                      Play{!reelStill && ` ${reelTitle(featuredReel)}`}
                      {featuredReel.video.length && <span class="length">{featuredReel.video.length}</span>}
                    </span>
                  </a>
                </div>
              </figure>
              <ul class="rows reel-list">
                {shownReels.map((reel, index) => (
                  <li>
                    <a
                      href={reel.url}
                      data-reel={reel.video.id}
                      data-reel-title={reelTitle(reel)}
                      aria-current={index === 0 ? "true" : undefined}
                    >
                      {reel.label}
                    </a>
                    <span class="meta">{reel.video.year}</span>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <p class="fallback">
              The reels can't be shown here right now. Watch them <a href={reels[0].url}>on Vimeo</a>.
            </p>
          )}
        </div>

        <div class="block" id="films">
          <h3>Credits</h3>
          <ul class="rows credits">
            {shownCredits.map((project) => (
              <li>
                {project.image ? (
                  <Image class="poster" src={project.image} width={80} height={120} alt="" loading="lazy" />
                ) : (
                  <span class="poster is-empty" />
                )}
                <span class="title">{project.title}</span>
                <span class="meta">
                  {project.episodes && (
                    <>
                      <span aria-hidden="true">{project.episodes} ep · </span>
                      <span class="visually-hidden">{project.episodes} episodes, </span>
                    </>
                  )}
                  {project.year}
                </span>
              </li>
            ))}
          </ul>
          <p class="more"><a href={imdbUrl}>Full filmography on IMDb</a></p>
        </div>
      </section>

      <section aria-labelledby="tools-title">
        <h2 id="tools-title">AI tools &amp; teaching</h2>

        <div class="block" id="apps">
          <h3>Apps</h3>
          <ul class="rows apps">
            {apps.map((app) => (
              <li>
                <a href={app.href}>{app.name}</a>
                {app.platforms && <span class="meta">{app.platforms}</span>}
                <p>{app.description}</p>
              </li>
            ))}
          </ul>
          <p class="more"><a href={githubUrl}>All my code on GitHub</a></p>
        </div>

        <div class="block" id="videos">
          <h3>Arctic Latent</h3>
          <p class="intro">My YouTube channel: ComfyUI and AI workflow tutorials for artists, on Windows and Linux.</p>
          {videos.length ? (
            <ul class="rows videos">
              {videos.map((video) => (
                <li>
                  <Image class="thumb" src={video.thumbnail} width={160} height={90} alt="" loading="lazy" />
                  <a href={video.href}>{video.title}</a>
                  <span class="meta">{video.publishedAt}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="fallback">The latest videos can't be shown here right now.</p>
          )}
          <p class="more"><a href={youtubeUrl}>Open the channel</a></p>
        </div>
      </section>
    </main>

    <footer>
      <ul class="contact">
        <li><a href={`mailto:${email}`}>{email}</a></li>
        <li><a href={linkedinUrl}>LinkedIn</a></li>
        <li><a href={resumeUrl}>Résumé</a></li>
        <li><a href={githubUrl}>GitHub</a></li>
        <li><a href={youtubeUrl}>YouTube</a></li>
        <li><a href={imdbUrl}>IMDb</a></li>
      </ul>
    </footer>

    <script>
      import "../scripts/reel.js";
    </script>
  </body>
