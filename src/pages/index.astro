---
import { Image } from "astro:assets";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Showcase from "../components/Showcase.astro";
import { fetchLatestVideos } from "../lib/youtube.js";
import { fetchFilmography } from "../lib/metacritic.js";
import { fetchReels } from "../lib/vimeo.js";
import {
  aboutParagraphs,
  apps,
  githubUrl,
  imdbUrl,
  ledeText,
  links,
  pageDescription,
  pageTitle,
  reels,
  resumeUrl,
  siteUrl,
  structuredData,
  youtubeUrl
} from "../site.js";

const [videos, filmography, reelVideos] = await Promise.all([fetchLatestVideos(), fetchFilmography(), fetchReels(reels)]);
const shownReels = reelVideos.filter((reel) => reel.video);

// On GitHub (the daily rebuild), a section that couldn't be fetched stops
// the build: GitHub Pages then keeps the last good version of the site
// instead of publishing it with that section empty.
if (process.env.GITHUB_ACTIONS && (videos.length === 0 || filmography.length === 0 || shownReels.length < reels.length)) {
  throw new Error(
    `Not publishing: ${videos.length} videos, ${filmography.length} credits, ${shownReels.length} of ${reels.length} reels fetched`
  );
}

const canonicalUrl = `${siteUrl}/`;
// (A PNG: social sites don't show SVG previews. public/og-image.svg is its source.)
const ogImageUrl = `${siteUrl}/og-image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- (Sections open with JavaScript; without it, by their address.) -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="author" content="Burce Boran" />
    <meta name="keywords" content="Burce Boran, Asset Supervisor, VFX, AI workflows, ComfyUI, creative technology, filmography, harlo, ComfyPilot, Bootcraft, Rust, Qt, GitHub, Vimeo, YouTube" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Geist-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Burce Boran" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Burce Boran website preview" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#1b1c21" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <div class="page-shell">
      <div class="backdrop" aria-hidden="true">
        <canvas class="aurora-canvas"></canvas>
        <canvas class="sculpture-canvas"></canvas>
      </div>
      <div class="grid-glow" aria-hidden="true"></div>

      <main>
        <div class="hero">
          <section class="intro" aria-label="Introduction">
            <a class="identity-mark" href="/" aria-label="Burce Boran: back to the start" data-home>
              <span class="eyebrow eyebrow-shadow" aria-hidden="true">Burce Boran</span>
              <span class="eyebrow eyebrow-main">Burce Boran</span>
            </a>
            <div class="headline-switcher" data-headline>
              <h1 class="headline-panel headline-default">
                A focused hub for the work I make, teach, and <span class="grad">build.</span>
              </h1>
              <div class="headline-panel headline-about" id="about">
                <div class="headline-about-body">
                  <div class="headline-about-copy">
                    {aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
                  </div>
                  <p class="about-resume-link">
                    <a href={resumeUrl} target="_blank" rel="noreferrer">View resume</a>
                  </p>
                </div>
              </div>
            </div>
            <p class="lede" data-lede>{ledeText}</p>
          </section>

          <nav class="links-panel" aria-label="Primary links">
            {links.map((link, index) => {
              const target = link.about ? "about" : link.section;
              return (
                <a
                  class="link-card"
                  href={target ? `#${target}` : link.href}
                  target={target ? undefined : "_blank"}
                  rel={target ? undefined : "noreferrer"}
                  data-opens={target}
                  aria-controls={target}
                  aria-expanded={target ? "false" : undefined}
                  style={`--delay:${index};`}
                >
                  <span class="link-label">
                    <span class="link-icon">
                      <Icon name={link.icon} />
                    </span>
                    <span>{link.label}</span>
                  </span>
                  <span class="link-note">{link.note}</span>
                </a>
              );
            })}
          </nav>
        </div>

        <Showcase id="videos" title="Latest from Arctic Latent" link={youtubeUrl} linkLabel="Open channel" empty={videos.length === 0}>
          <div class="video-grid">
            {videos.map((video) => (
              <a class="video-card" href={video.href} target="_blank" rel="noreferrer">
                <div class="video-thumb-wrap">
                  <Image class="video-thumb" src={video.thumbnail} width={480} height={360} alt="" loading="lazy" />
                </div>
                <div class="video-meta">
                  <p class="video-date">{video.publishedAt}</p>
                  <h3>{video.title}</h3>
                </div>
              </a>
            ))}
          </div>
          <Fragment slot="empty">
            Latest uploads are temporarily unavailable. Visit the
            <a href={youtubeUrl} target="_blank" rel="noreferrer">Arctic Latent channel</a>.
          </Fragment>
        </Showcase>

        <Showcase id="apps" title="Apps I build · free and open source" link={githubUrl} linkLabel="Open GitHub">
          <div class="repo-grid">
            {apps.map((app) => (
              <a class="repo-card" href={app.href} target="_blank" rel="noreferrer" style={`--repo-accent:${app.accent};`}>
                <div class="repo-thumb">
                  <div class="repo-thumb-noise"></div>
                  <img class:list={["repo-logo", app.tile && "repo-logo-tile"]} src={app.logo} alt="" width="56" height="56" loading="lazy" />
                  <p class="repo-thumb-label">{app.platforms}</p>
                  <h3>{app.name}</h3>
                </div>
                <div class="repo-meta">
                  <p>{app.description}</p>
                  <div class="repo-stats">
                    {app.tech.map((tech) => (
                      <span class="repo-pill">
                        <span class="repo-pill-dot"></span>
                        {tech}
                      </span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </Showcase>

        <Showcase id="films" title="Selected Filmography" link={imdbUrl} linkLabel="Open IMDb" empty={filmography.length === 0}>
          <div class="film-grid">
            {filmography.map((project) => (
              <a class="film-card" href={project.href} target="_blank" rel="noreferrer">
                <div class="film-poster-wrap">
                  {project.image ? (
                    <Image class="film-poster" src={project.image} width={400} height={600} alt={`Poster for ${project.title}`} loading="lazy" />
                  ) : (
                    <div class="film-poster film-poster-fallback"></div>
                  )}
                </div>
                <div class="film-meta">
                  <p class="film-overline">{project.type} • {project.year}</p>
                  <h3>{project.title}</h3>
                  <p>{project.role}</p>
                </div>
              </a>
            ))}
          </div>
          <Fragment slot="empty">
            Filmography is temporarily unavailable here. Visit
            <a href={imdbUrl} target="_blank" rel="noreferrer">IMDb</a>.
          </Fragment>
        </Showcase>

        <Showcase id="reels" title="Selected Reels" empty={shownReels.length === 0}>
          <div class="reel-grid">
            {shownReels.map((reel) => (
              <article class="reel-card">
                <div class="reel-card-header">
                  <h3 class="reel-title">{reel.label}</h3>
                  <a class="showcase-link" href={reel.url} target="_blank" rel="noreferrer">Open on Vimeo</a>
                </div>
                <div class="reel-player">
                  <iframe
                    src={`https://player.vimeo.com/video/${reel.video.id}?title=0&byline=0&portrait=0`}
                    title={reel.video.title}
                    loading="lazy"
                    allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
                    allowfullscreen
                  ></iframe>
                </div>
              </article>
            ))}
          </div>
          <Fragment slot="empty">
            The reels are temporarily unavailable here. Watch them on
            <a href={reels[0].url} target="_blank" rel="noreferrer">Vimeo</a>.
          </Fragment>
        </Showcase>
      </main>
    </div>

    <div class="back-to-top-wrap">
      <button class="back-to-top" type="button" data-back-to-top>
        <span class="back-to-top-icon"><Icon name="up" /></span>
        Top
      </button>
    </div>

    <script>
      import "../scripts/page.js";
      import { startBackdrop } from "../scripts/backdrop.js";
      startBackdrop(document.querySelector(".aurora-canvas"), document.querySelector(".sculpture-canvas"));
    </script>
  </body>
</html>
