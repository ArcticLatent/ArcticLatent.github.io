---
import { Image } from "astro:assets";
import "../styles/global.css";
// fastfetch's logo: me, in pixel art.
import portrait from "../assets/burce-hero.png";
import { fetchLatestVideos } from "../lib/youtube.js";
import { fetchFilmography, matchCredits } from "../lib/metacritic.js";
import { fetchReels } from "../lib/vimeo.js";
import {
  apps,
  credits,
  email,
  githubUrl,
  imdbUrl,
  linkedinUrl,
  pageDescription,
  pageTitle,
  reels,
  resumeUrl,
  siteUrl,
  structuredData,
  youtubeUrl
} from "../site.js";

const [videos, filmography, reelVideos] = await Promise.all([fetchLatestVideos(), fetchFilmography(), fetchReels(reels)]);
const shownReels = reelVideos.filter((reel) => reel.video);
const [featuredReel] = shownReels;
const shownCredits = matchCredits(credits, filmography);

// On GitHub (the daily rebuild), a section that couldn't be fetched stops
// the build: GitHub Pages then keeps the last good version of the site
// instead of publishing it with that section empty.
if (process.env.GITHUB_ACTIONS && (videos.length === 0 || filmography.length === 0 || shownReels.length < reels.length)) {
  throw new Error(
    `Not publishing: ${videos.length} videos, ${filmography.length} credits, ${shownReels.length} of ${reels.length} reels fetched`
  );
}

const canonicalUrl = `${siteUrl}/`;
// (A PNG: social sites don't show SVG previews. public/og-image.svg is its source.)
const ogImageUrl = `${siteUrl}/og-image.png`;
const reelTitle = (reel) => `${reel.label}, ${reel.video.year}`;
const reelStill = featuredReel && (featuredReel.still === false ? "" : featuredReel.still ?? featuredReel.video.still);

// The three shows fastfetch names; the rest are counted.
const namedShows = ["The Mandalorian", "House of the Dragon", "Avatar: The Last Airbender"];
const otherShows = shownCredits.length - namedShows.length;

// When the site was built (daily), as tmux shows the date: 13-Nov-26.
const built = new Date();
const builtDate = `${String(built.getUTCDate()).padStart(2, "0")}-${built.toLocaleString("en", { month: "short", timeZone: "UTC" })}-${String(built.getUTCFullYear()).slice(2)}`;

const contactLinks = [
  { key: "email", href: `mailto:${email}`, text: email },
  { key: "linkedin", href: linkedinUrl, text: "linkedin.com/in/burceboran" },
  { key: "résumé", href: resumeUrl, text: "Burce_Boran_Resume_2026.pdf" },
  { key: "github", href: githubUrl, text: "github.com/ArcticLatent" },
  { key: "youtube", href: youtubeUrl, text: "youtube.com/@ArcticLatent" },
  { key: "imdb", href: imdbUrl, text: "imdb.com/name/nm9667865" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="author" content="Burce Boran" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/CommitMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Burce Boran" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Burce Boran, GenAI Pipeline TD and Asset Supervisor" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#0b0e12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#dde2e8" media="(prefers-color-scheme: light)" />
    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <!-- The page is a terminal running tmux: each part is a command and what it
         printed. About runs across the top, Film & VFX and AI tools & teaching
         sit side by side in two panes, Contact ends it with a prompt, and the
         status bar along the bottom is the page's navigation. -->
    <a class="skip" href="#content">skip to content</a>
    <div class="term">
      <div class="titlebar" aria-hidden="true">
        <span class="titlebar-text" data-titlebar>burce@arcticlatent: ~</span>
        <span class="window-controls">
          <span class="window-control minimize"><svg viewBox="0 0 10 10"><path d="M2.5 5h5" /></svg></span>
          <span class="window-control maximize"><svg viewBox="0 0 10 10"><path d="M5 2.5v5M2.5 5h5" /></svg></span>
          <span class="window-control close"><svg viewBox="0 0 10 10"><path d="M3 3l4 4M7 3l-4 4" /></svg></span>
        </span>
      </div>

      <!-- First in the source, so keyboards and screen readers reach it first;
           CSS draws it along the bottom, where tmux keeps it. -->
      <nav class="status" aria-label="Sections">
        <span class="session" aria-hidden="true">[burce]</span>
        <ul>
          <li><a href="#about" data-goto="about"><span aria-hidden="true">0:</span>about</a></li>
          <li><a href="#film" data-goto="film"><span aria-hidden="true">1:</span>film</a></li>
          <li><a href="#tools" data-goto="tools"><span aria-hidden="true">2:</span>tools</a></li>
          <li><a href="#contact" data-goto="contact"><span aria-hidden="true">3:</span>contact</a></li>
        </ul>
        <!-- tmux's command prompt (src/scripts/shell.js): ":" anywhere opens
             it here. Without JavaScript neither shows. -->
        <button class="status-hint" type="button" data-command-open aria-keyshortcuts=":" hidden>: command</button>
        <form class="status-prompt" data-command-prompt hidden>
          <label for="status-command">:<span class="visually-hidden"> Command (help lists them; Escape closes)</span></label>
          <span class="field">
            <input
              id="status-command"
              name="status-command"
              type="text"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="go"
              data-command-input
            />
            <span class="cursor" aria-hidden="true"></span>
          </span>
        </form>
        <span class="host" aria-hidden="true">"arcticlatent" {builtDate}</span>
      </nav>

      <main class="panes" id="content" tabindex="-1">
        <header class="pane is-about" id="about" data-pane="about">
          <p class="pane-title" aria-hidden="true"><span>0</span> About</p>

          <div class="runs">
            <div class="run">
              <p class="cmd" aria-hidden="true"><span class="cwd">~</span> <span class="ps">$</span> fastfetch</p>
              <div class="fastfetch">
                <Image
                  class="logo"
                  src={portrait}
                  width={160}
                  densities={[1, 2, 3]}
                  alt="Burce Boran in pixel art"
                  loading="eager"
                />
                <div class="facts">
                  <h1>Burce Boran</h1>
                  <p class="underline" aria-hidden="true">-----------</p>
                  <dl>
                    <div><dt>Role</dt><dd><span class="nowrap">GenAI Pipeline TD</span> <span class="nowrap">· Asset Supervisor</span></dd></div>
                    <div><dt>Uptime</dt><dd>15+ years in visual effects</dd></div>
                    <div><dt>Shows</dt><dd>{namedShows.join(", ")}{otherShows > 0 && <> <a class="nowrap" href="#films">+{otherShows} more</a></>}</dd></div>
                    <div><dt>Apps</dt><dd><a href="#apps">{apps.map((app) => app.name).join(", ")}</a></dd></div>
                    <div><dt>Channel</dt><dd><a href="#videos">Arctic Latent</a>, ComfyUI and AI workflows</dd></div>
                    <div><dt>Contact</dt><dd><a href={`mailto:${email}`}>{email}</a> · <a class="nowrap" href={resumeUrl}>résumé (PDF)</a></dd></div>
                  </dl>
                  <p class="swatches" aria-hidden="true">
                    <span class="c0"></span><span class="c1"></span><span class="c2"></span><span class="c3"></span><span
                      class="c4"
                    ></span><span class="c5"></span><span class="c6"></span><span class="c7"></span>
                  </p>
                </div>
              </div>
            </div>

            <div class="run">
              <p class="cmd" aria-hidden="true"><span class="cwd">~</span> <span class="ps">$</span> cat about.txt</p>
              <div class="prose" data-file="about.txt">
                <p>
                  I work in the VFX industry as a GenAI pipeline TD, bringing generative AI tools and workflows into how
                  shows get made. Before that I spent over 15 years in visual effects, many of them as an asset
                  supervisor, building and leading the models, textures and look development for films and series.
                </p>
                <p>
                  Outside the studio I make <a href="#apps">free, open-source apps</a> and teach artists ComfyUI and AI
                  workflows on my YouTube channel, <a href="#videos">Arctic Latent</a>.
                </p>
              </div>
            </div>
          </div>
        </header>

        <section class="pane is-film" id="film" data-pane="film" aria-labelledby="film-title">
          <h2 class="pane-title" id="film-title"><span aria-hidden="true">1</span> Film &amp; VFX</h2>

          <div class="run" id="reels">
            <h3 class="cmd">
              <span aria-hidden="true"><span class="cwd">~/film</span> <span class="ps">$</span> mpv reels/latest.mp4</span>
              <span class="visually-hidden">Reels</span>
            </h3>
            {featuredReel ? (
              <>
                <figure class="reel">
                  <div class="reel-frame" data-reel-frame>
                    <a
                      class:list={["reel-still", !reelStill && "is-blank"]}
                      href={featuredReel.url}
                      data-reel={featuredReel.video.id}
                      data-reel-title={reelTitle(featuredReel)}
                      aria-label={`Play ${reelTitle(featuredReel)}`}
                    >
                      {reelStill &&
                        (reelStill.startsWith("/") ? (
                          <img src={reelStill} width="1280" height="720" alt="" />
                        ) : (
                          <Image src={reelStill} width={1280} height={720} alt="" loading="eager" />
                        ))}
                      <span class="play" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M7 4.5v15L19.5 12z" /></svg>
                        play{!reelStill && ` ${reelTitle(featuredReel)}`}
                        {featuredReel.video.length && <span class="length">{featuredReel.video.length}</span>}
                      </span>
                    </a>
                  </div>
                </figure>
                <p class="cmd" aria-hidden="true"><span class="cwd">~/film</span> <span class="ps">$</span> ls reels</p>
                <ul class="ls reel-list">
                  {shownReels.map((reel, index) => (
                    <li>
                      <a
                        href={reel.url}
                        data-reel={reel.video.id}
                        data-reel-title={reelTitle(reel)}
                        aria-current={index === 0 ? "true" : undefined}
                      >
                        {reel.label}
                      </a>
                      <span class="meta">{reel.video.year}</span>
                      <span class="meta">{reel.video.length}</span>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <p class="error">
                <span class="tag">error:</span> the reels can't be shown here right now. Watch them
                <a href={reels[0].url}>on Vimeo</a>.
              </p>
            )}
          </div>

          <div class="run" id="films">
            <h3 class="cmd">
              <span aria-hidden="true"><span class="cwd">~/film</span> <span class="ps">$</span> ls credits</span>
              <span class="visually-hidden">Credits</span>
            </h3>
            <table class="credits">
              <thead>
                <tr>
                  <th scope="col"><span class="visually-hidden">Poster</span></th>
                  <th scope="col">Title</th>
                  <th scope="col" class="kind">Kind</th>
                  <th scope="col" class="num"><abbr title="Episodes">Ep</abbr></th>
                  <th scope="col" class="num">Year</th>
                </tr>
              </thead>
              <tbody>
                {shownCredits.map((project) => (
                  <tr>
                    <td class="poster-cell">
                      {project.image ? (
                        <Image class="poster" src={project.image} width={60} height={90} alt="" loading="lazy" />
                      ) : (
                        <span class="poster is-empty" />
                      )}
                    </td>
                    <td class="title">{project.title}</td>
                    <td class="kind">{project.type}</td>
                    <td class="num">
                      {project.episodes ?? (
                        <>
                          <span aria-hidden="true">-</span><span class="visually-hidden">none</span>
                        </>
                      )}
                    </td>
                    <td class="num">{project.year}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="comment"># full filmography: <a href={imdbUrl}>IMDb</a></p>
          </div>
        </section>

        <section class="pane is-ai" id="tools" data-pane="tools" aria-labelledby="tools-title">
          <h2 class="pane-title" id="tools-title"><span aria-hidden="true">2</span> AI tools &amp; teaching</h2>

          <div class="run" id="apps">
            <h3 class="cmd">
              <span aria-hidden="true"><span class="cwd">~/tools</span> <span class="ps">$</span> ls apps</span>
              <span class="visually-hidden">Apps</span>
            </h3>
            <p class="comment"># free and open source, made outside the studio</p>
            <ul class="apps">
              {apps.map((app) => (
                <li>
                  <a class="name" href={app.href}>{app.name}</a>
                  {app.platforms && <span class="meta">{app.platforms}</span>}
                  <p>{app.description}</p>
                </li>
              ))}
            </ul>
            <p class="comment"># all my code: <a href={githubUrl}>github.com/ArcticLatent</a></p>
          </div>

          <div class="run" id="videos">
            <h3 class="cmd">
              <span aria-hidden="true"><span class="cwd">~/tools</span> <span class="ps">$</span> cat arctic-latent/README</span>
              <span class="visually-hidden">Arctic Latent</span>
            </h3>
            <div class="prose" data-file="arctic-latent/README">
              <p>
                My YouTube channel: ComfyUI and AI workflow tutorials for artists, on Windows and Linux. Before it I
                taught 3D surfacing at Seneca Polytechnic for four years, and I've spoken about careers in VFX and 3D at
                TIFF Next Wave and Anadolu University.
              </p>
            </div>
            <p class="cmd" aria-hidden="true">
              <span class="cwd">~/tools</span> <span class="ps">$</span> yt-dlp --flat-playlist -I 1:4 @ArcticLatent
            </p>
            {videos.length ? (
              <ul class="videos">
                {videos.map((video) => (
                  <li>
                    <Image class="thumb" src={video.thumbnail} width={160} height={90} alt="" loading="lazy" />
                    <a href={video.href}>{video.title}</a>
                    {video.publishedAt && <span class="meta">{video.publishedAt}</span>}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="error"><span class="tag">error:</span> the latest videos can't be shown here right now.</p>
            )}
            <p class="comment"># the channel: <a href={youtubeUrl}>youtube.com/@ArcticLatent</a></p>
          </div>
        </section>

        <section class="pane is-contact" id="contact" data-pane="contact" aria-labelledby="contact-title">
          <h2 class="pane-title" id="contact-title"><span aria-hidden="true">3</span> Contact</h2>

          <div class="run">
            <p class="cmd" aria-hidden="true"><span class="cwd">~</span> <span class="ps">$</span> cat contact</p>
            <dl class="contact">
              {contactLinks.map((link) => (
                <div>
                  <dt>{link.key}</dt>
                  <dd><a href={link.href}>{link.text}</a></dd>
                </div>
              ))}
            </dl>
          </div>

          <!-- Without JavaScript the session ends on an idle prompt; with it,
               the prompt takes commands (src/scripts/shell.js). -->
          <div class="shell" data-shell>
            <div class="log" data-log aria-live="polite"></div>
            <p class="cmd idle" aria-hidden="true" data-idle>
              <span class="cwd">~</span> <span class="ps">$</span> <span class="cursor"></span>
            </p>
            <form class="prompt" data-prompt hidden>
              <label for="command"
                ><span class="cwd" data-cwd>~</span> <span class="ps">$</span><span class="visually-hidden">
                  Type a command (help lists them)</span
                ></label
              >
              <span class="field">
                <input
                  id="command"
                  name="command"
                  type="text"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                  enterkeyhint="go"
                  data-input
                />
                <span class="cursor" data-cursor aria-hidden="true"></span>
                <span class="hint" data-hint aria-hidden="true">type help</span>
              </span>
            </form>
          </div>
        </section>
      </main>

    </div>

    <script>
      import "../scripts/reel.js";
      import "../scripts/shell.js";
      import "../scripts/status.js";
    </script>
  </body>
</html>
